# Copy to .env (gitignored) at the repo root. `python -m nua` (nua/__main__.py) loads <root>/.env once
# it has found the repo root, and nua/settings.py loads it for the `local` role; variables already set
# in the shell win. The root itself must come from --root or the shell, never from this file.
#
# Local runs only need the model keys. Everything below them is for running the services yourself.
# The services never read .env on their own, so pass it to uvicorn from the repo root:
#   SERVICE_ROLE=mcp uv run uvicorn --env-file .env service.main:app      (or set SERVICE_ROLE in .env)
# Without --env-file, SERVICE_ROLE and every setting here are ignored and you get the receiver.
# On Cloud Run these come from infra/terraform and Secret Manager, never from a .env file.

# ---------- models (nua/providers.py) ----------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gemini Developer API key, paid tier (prompts are not used to improve Google's products)
GEMINI_API_KEY=

# ---------- local runs ----------
# Repo root for `uv run python -m nua` when run from outside the clone. Set it in the shell, not here: the
# root decides which .env is read. Default: the nearest folder at or above the current one with
# config/pipeline.yml; none found is an error. NUA_REPO_ROOT (read by nua/settings.py) works too.
# NUA_ROOT=/path/to/nua-discovery

# ---------- running the services ----------
# receiver | processor | mcp
# SERVICE_ROLE=receiver
# 1 skips the Cloud Scheduler OIDC check on /sweep and /rollup (never set it on Cloud Run)
# NUA_DEV=1
# 1 sends every Slack post to the test channel
# NUA_SLACK_TEST=1
# Where the services keep their clone of the repo
# NUA_REPO_DIR=/tmp/nua-repo
# Attempts before a task gives up (matches the queue's maxAttempts)
# NUA_TASK_MAX_ATTEMPTS=5
# Channel for failure alerts when the repo itself cannot be loaded
# NUA_OPS_CHANNEL=#discovery-ops

# GitHub repo and GitHub App
REPO_SLUG=
REPO_BRANCH=main
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# The app's URL name; its pushes show as <slug>[bot] and /github ignores them
GITHUB_APP_SLUG=
# PEM text; literal \n sequences are accepted
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Slack app
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Cloud Tasks (queue nua) and Cloud Scheduler
GCP_PROJECT=
TASKS_LOCATION=us-west1
TASKS_QUEUE=nua
PROCESSOR_URL=
TASKS_SERVICE_ACCOUNT=
RECEIVER_URL=
SCHEDULER_SERVICE_ACCOUNT=

# Recorders. Circleback keys and signing secrets are per person: <PERSON> is the key in
# config/people.yml in upper case (ALEX, SAM, JORDAN). Fill them in only for the people listed in
# circleback_people in terraform.tfvars. A Granola-only or Circleback-only team leaves the other empty.
GRANOLA_API_KEY=
GRANOLA_WEBHOOK_SECRET=
CIRCLEBACK_API_KEY_ALEX=
CIRCLEBACK_SIGNING_SECRET_ALEX=
CIRCLEBACK_API_KEY_SAM=
CIRCLEBACK_SIGNING_SECRET_SAM=
CIRCLEBACK_API_KEY_JORDAN=
CIRCLEBACK_SIGNING_SECRET_JORDAN=

# MCP server sign-in (service/mcp.py auth_from_env). Not deployed for now (infra/terraform deploys it
# only with deploy_mcp = true). github | google | none. The server refuses to
# start when it is unset, so it never serves the calls without sign-in by accident. none is for running
# the MCP service yourself only (uvicorn --env-file .env, SERVICE_ROLE=mcp; write tools then act as
# MCP_DEV_USER); Cloud Run gets mcp_auth from infra/terraform.
MCP_AUTH=none
# Person key from config/people.yml that write tools act as while sign-in is off
# MCP_DEV_USER=alex
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
# The MCP service's public URL, e.g. https://nua-mcp-....run.app
MCP_BASE_URL=
# Any long random string. Sign-in tokens are signed with it and the sign-in store below is named
# and encrypted with it, so keep it for good: a new key signs everyone out. Unset, it is derived
# from MCP_OAUTH_CLIENT_SECRET.
MCP_JWT_SIGNING_KEY=
# Where the OAuth provider keeps its sign-in state (client registrations, token mappings). It must
# outlive the process: on Cloud Run it is the Cloud Storage volume infra/terraform mounts at /oauth.
# Unset, FastMCP uses a folder in your user data dir, which is fine locally.
# FASTMCP_HOME=/oauth
# Time limit for the MCP `ask` tool in seconds (default 200). claude.ai gives up on a tool call at 240s,
# the tightest client (Cloud Run allows 300s), and ask still checks citations after the limit, so keep
# it well under 240.
# MCP_ASK_DEADLINE_SECONDS=200
